<Window x:Class="EdgeMark.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EdgeMark"
        Title="{DynamicResource L.MenuTitle}"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource M.Fg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True">
    <Border x:Name="Card" Background="{DynamicResource MenuBg}" CornerRadius="8" Width="310">
        <Grid x:Name="Body" Margin="4">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок: слева тонкая кнопка «новая группа», затем название, справа кнопки -->
            <Grid Grid.Row="0" Margin="2,4,2,2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="24" FontSize="12" Content="&#xE8FD;"
                            ToolTip="{DynamicResource L.NewGroup}" Click="NewGroup_Click" Margin="0,0,4,0"/>
                    <TextBlock Text="{DynamicResource L.Bookmarks}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource M.SubFg}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8F4;" ToolTip="{DynamicResource L.AddFolder}"
                            Click="Add_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="{DynamicResource L.AddFile}"
                            Click="AddFile_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{DynamicResource L.Settings}"
                            Click="Settings_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="6,2,6,4" Background="{DynamicResource M.Separator}"/>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ItemsControl x:Name="FolderItems" Focusable="False">
                        <ItemsControl.Resources>

                            <!-- Закладка -->
                            <DataTemplate DataType="{x:Type local:MenuItemVm}">
                                <!-- Подложка развёрнутой группы (у строк вне групп прозрачная) -->
                                <Border Background="{Binding FrameBg}" CornerRadius="{Binding FrameCorner}" Padding="{Binding FramePad}">
                                    <Button x:Name="ItemBtn" Style="{StaticResource FolderRow}" Click="Item_Click" Tag="{Binding}"
                                            Opacity="{Binding Opacity}" ToolTip="{Binding Tip}" Margin="{Binding RowMargin}"
                                            BorderBrush="{Binding StripeBrush}">
                                        <Grid MinHeight="26">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                            <!-- Справа: номер; при наведении вместо него — «копировать путь» и «изменить» -->
                                            <Grid Grid.Column="2" Margin="8,0,0,0">
                                                <TextBlock x:Name="HotkeyText" Text="{Binding Number}" FontSize="11" Margin="0,0,4,0"
                                                           Foreground="{DynamicResource M.SubFg}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <StackPanel x:Name="Actions" Orientation="Horizontal" Visibility="Hidden" Opacity="0">
                                                    <Button Style="{StaticResource RowAction}" Width="42" Margin="0,0,4,0"
                                                            Content="&#xE8C8;" ToolTip="{DynamicResource L.CopyPath}" Tag="{Binding}" Click="Copy_Click"/>
                                                    <Button Style="{StaticResource RowAction}" Width="26"
                                                            Content="&#xE70F;" ToolTip="{DynamicResource L.Edit}" Tag="{Binding}" Click="Edit_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=ItemBtn}" Value="True">
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="HotkeyText" Property="Visibility" Value="Hidden"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>


                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Подсказка, пока над окном держат файлы / папки -->
                <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Bottom"
                      Margin="2,0,2,2" MinHeight="44">
                    <Rectangle RadiusX="6" RadiusY="6" Fill="{DynamicResource M.ActionBg}"
                               Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="4 3"/>
                    <TextBlock x:Name="DropText" Text="{DynamicResource L.MenuDrop}" FontSize="12.5" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="12,8" VerticalAlignment="Center" Foreground="{DynamicResource M.Fg}"/>
                </Grid>

                <TextBlock x:Name="Empty" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="16,14,16,18" FontSize="12.5" Foreground="{DynamicResource M.SubFg}"
                           Text="{DynamicResource L.MenuEmpty}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
