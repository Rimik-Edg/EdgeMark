<Window x:Class="EdgeMark.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EdgeMark"
        Title="{DynamicResource L.NotesTitle}"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource M.Fg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True">
    <Border x:Name="Card" Background="{DynamicResource MenuBg}" CornerRadius="8" Width="310">
        <Grid x:Name="Body" Margin="4">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="2,4,2,2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="24" FontSize="12" Content="&#xE8FD;"
                            ToolTip="{DynamicResource L.NewGroup}" Click="NewGroup_Click" Margin="0,0,4,0"/>
                    <TextBlock Text="{DynamicResource L.Notes}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource M.SubFg}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="{DynamicResource L.NewNote}"
                            Click="New_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{DynamicResource L.OpenNotesFolder}"
                            Click="Folder_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="6,2,6,4" Background="{DynamicResource M.Separator}"/>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ItemsControl x:Name="NoteItems" Focusable="False">
                        <ItemsControl.Resources>
                            <!-- Заметка (заголовок группы берётся общий, из App.xaml) -->
                            <DataTemplate DataType="{x:Type local:NoteVm}">
                                <!-- Подложка развёрнутой группы (у строк вне групп прозрачная) -->
                                <Border Background="{Binding FrameBg}" CornerRadius="{Binding FrameCorner}" Padding="{Binding FramePad}">
                                    <Button x:Name="RowBtn" Style="{StaticResource FolderRow}" Click="Row_Click" Tag="{Binding}"
                                            Margin="{Binding RowMargin}" BorderBrush="{Binding StripeBrush}" Opacity="{Binding Opacity}">
                                        <Grid MinHeight="26">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Стрелка: показать / скрыть текст (на месте значка папки) -->
                                            <Button Style="{StaticResource ChevronButton}" HorizontalAlignment="Left" Margin="-1,0,0,0"
                                                    Content="{Binding Chevron}" ToolTip="{DynamicResource L.ToggleText}"
                                                    Tag="{Binding}" Click="Toggle_Click"/>

                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                            <!-- Справа: дата; при наведении — «копировать текст» и «копировать файл» -->
                                            <Grid Grid.Column="2" Margin="8,0,0,0">
                                                <TextBlock x:Name="DateText" Text="{Binding Date}" FontSize="11" Margin="0,0,4,0"
                                                           Foreground="{DynamicResource M.SubFg}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <StackPanel x:Name="Actions" Orientation="Horizontal" Visibility="Hidden" Opacity="0">
                                                    <Button Style="{StaticResource RowAction}" Width="42" Margin="0,0,4,0"
                                                            Content="&#xE8C8;" ToolTip="{DynamicResource L.CopyText}" Tag="{Binding}"
                                                            Click="CopyText_Click"/>
                                                    <Button Style="{StaticResource RowAction}" Width="26"
                                                            Content="&#xE7C3;" ToolTip="{DynamicResource L.CopyFile}"
                                                            Tag="{Binding}" Click="CopyFile_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Текст заметки: прокрутка колесом, выделение мышью, Ctrl+C / Ctrl+A -->
                                            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,7,0,1" CornerRadius="4"
                                                    Background="{DynamicResource M.ActionBg}"
                                                    Visibility="{Binding PreviewVisibility}">
                                                <TextBox Style="{StaticResource ReadOnlyText}" MaxHeight="210"
                                                         Text="{Binding FullText, Mode=OneWay}"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowBtn}" Value="True">
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="DateText" Property="Visibility" Value="Hidden"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Подсказка, пока над окном держат .txt файл -->
                <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" MinHeight="70" Margin="2">
                    <Rectangle RadiusX="6" RadiusY="6" Fill="{DynamicResource M.ActionBg}"
                               Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="4 3"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                        <Path Data="M0,0 L12,0 L12,16 L6,11.5 L0,16 Z" Fill="{DynamicResource Accent}"
                              HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource L.NotesDrop}" FontSize="13" TextAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{DynamicResource M.Fg}"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="Empty" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="16,14,16,18" FontSize="12.5" Foreground="{DynamicResource M.SubFg}"
                           Text="{DynamicResource L.NotesEmpty}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
