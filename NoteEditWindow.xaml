<Window x:Class="EdgeMark.NoteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Note}" Icon="pack://application:,,,/Assets/app.ico"
        Width="580" Height="540" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название (= имя .txt файла) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="TitleBox" Style="{StaticResource Input}" FontSize="16" FontWeight="SemiBold"
                     TextChanged="Any_Changed"/>
            <TextBlock x:Name="TitlePlaceholder" Text="{DynamicResource L.NoteTitlePlaceholder}" IsHitTestVisible="False"
                       FontSize="16" Foreground="{DynamicResource SubFg}" Margin="9,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- Текст -->
        <TextBox x:Name="BodyBox" Grid.Row="1" Style="{StaticResource InputMultiline}" FontSize="13.5"
                 TextChanged="Any_Changed"/>

        <!-- Низ -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteBtn" Style="{StaticResource PlainButton}" Foreground="{DynamicResource Danger}"
                    Click="Delete_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="DeleteText" Text="{DynamicResource L.Delete}"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="InfoText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontSize="11.5"
                       Foreground="{DynamicResource SubFg}" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource PlainButton}" Content="{DynamicResource L.Cancel}" MinWidth="90" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Style="{StaticResource AccentButton}" Content="{DynamicResource L.Save}" MinWidth="104" Click="Save_Click"
                        ToolTip="Ctrl+S"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
