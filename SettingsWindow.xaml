<Window x:Class="EdgeMark.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EdgeMark"
        Title="{DynamicResource L.SettingsTitle}" Icon="pack://application:,,,/Assets/app.ico"
        Width="980" Height="900" MinWidth="900" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="{DynamicResource L.Bookmarks}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource L.SettingsSub}"
                       Foreground="{DynamicResource SubFg}" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- Список -->
            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource MenuBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="Folders" Style="{StaticResource FolderList}" AllowDrop="True"
                             SelectionChanged="Folders_SelectionChanged" Drop="Folders_Drop" DragOver="Folders_DragOver">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Left"
                                           Opacity="{Binding IconOpacity}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource SubFg}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,2">
                        <Button Style="{StaticResource PlainButton}" Click="Add_Click" Margin="0,0,6,0" Padding="11,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{DynamicResource L.AddFolderShort}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PlainButton}" Click="AddFile_Click" Margin="0,0,6,0" Padding="11,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{DynamicResource L.AddFileShort}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemoveBtn" Style="{StaticResource PlainIconButton}" Content="&#xE74D;"
                                ToolTip="{DynamicResource L.Remove}" Click="Remove_Click" Margin="0,0,6,0"/>
                        <Button x:Name="UpBtn" Style="{StaticResource PlainIconButton}" Content="&#xE70E;"
                                ToolTip="{DynamicResource L.MoveUp}" Click="Up_Click" Margin="0,0,6,0"/>
                        <Button x:Name="DownBtn" Style="{StaticResource PlainIconButton}" Content="&#xE70D;"
                                ToolTip="{DynamicResource L.MoveDown}" Click="Down_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Редактор выбранного пункта -->
            <Border Grid.Column="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource MenuBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel x:Name="Editor">
                    <TextBlock Text="{DynamicResource L.Name}" Foreground="{DynamicResource SubFg}" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource Input}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{DynamicResource L.Path}" Foreground="{DynamicResource SubFg}" Margin="0,14,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Style="{StaticResource Input}"
                                 Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource PlainIconButton}" Content="&#xE8B7;" ToolTip="{DynamicResource L.PickFolder}"
                                    Margin="6,0,0,0" Click="Browse_Click"/>
                            <Button Style="{StaticResource PlainIconButton}" Content="&#xE8E5;" ToolTip="{DynamicResource L.PickFile}"
                                    Margin="6,0,0,0" Click="BrowseFile_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12"
                               Margin="0,7,0,0" TextWrapping="Wrap"/>

                    <Button Style="{StaticResource PlainButton}" Content="{DynamicResource L.TestOpen}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="Test_Click"/>

                    <TextBlock Foreground="{DynamicResource SubFg}" FontSize="11.5" TextWrapping="Wrap" Margin="0,18,0,0"
                               LineHeight="17" Text="{DynamicResource L.PathHint}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Опции -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource MenuBorder}"
                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                    <TextBlock Text="{DynamicResource L.ScreenEdge}" Foreground="{DynamicResource SubFg}" Margin="0,0,0,7"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="EdgeLeft" Style="{StaticResource Segment}" GroupName="Edge" Content="{DynamicResource L.EdgeLeft}"/>
                        <RadioButton x:Name="EdgeRight" Style="{StaticResource Segment}" GroupName="Edge" Content="{DynamicResource L.EdgeRight}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource L.Language}" Foreground="{DynamicResource SubFg}" Margin="0,12,0,7"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangRu" Style="{StaticResource Segment}" GroupName="Lang" Content="Русский"
                                     Checked="Lang_Checked"/>
                        <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" GroupName="Lang" Content="English"
                                     Checked="Lang_Checked"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="AutostartBox" Style="{StaticResource Toggle}" Content="{DynamicResource L.Autostart}"/>
                    <CheckBox x:Name="HideFsBox" Style="{StaticResource Toggle}"
                              Content="{DynamicResource L.HideFullscreen}"/>

                    <!-- Программы, в которых язычки прячутся -->
                    <TextBlock Text="{DynamicResource L.HideInApps}" Margin="0,12,0,3"/>
                    <TextBlock Text="{DynamicResource L.HideInAppsHint}" Foreground="{DynamicResource SubFg}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,0,0,7" MaxWidth="420" HorizontalAlignment="Left"/>
                    <ItemsControl x:Name="HideApps" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource MenuBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="9,3,3,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource ItemButton}" Foreground="{DynamicResource SubFg}"
                                                FontFamily="{StaticResource IconFont}" FontSize="9" Content="&#xE711;"
                                                Padding="6,4" Margin="6,0,0,0" Tag="{Binding}" Click="RemoveApp_Click"
                                                ToolTip="{DynamicResource L.RemoveApp}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <Grid>
                            <Button x:Name="AddOpenBtn" Style="{StaticResource PlainButton}" Padding="11,5" Margin="0,0,6,0"
                                    Click="AddFromOpen_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource L.AddFromOpen}"/>
                                </StackPanel>
                            </Button>
                            <!-- Список открытых программ -->
                            <Popup x:Name="OpenAppsPop" PlacementTarget="{Binding ElementName=AddOpenBtn}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource MenuBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,10,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="320" Width="330" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="OpenAppsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource PlainButton}" Background="Transparent"
                                                            HorizontalContentAlignment="Left" Padding="9,5" Margin="0,1"
                                                            Tag="{Binding Exe}" Click="PickOpenApp_Click">
                                                        <StackPanel HorizontalAlignment="Left" Width="296">
                                                            <TextBlock Text="{Binding Exe}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource SubFg}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Style="{StaticResource PlainButton}" Padding="11,5" Click="AddExe_Click"
                                Content="{DynamicResource L.AddExe}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Горячие клавиши -->
                <Grid Grid.Column="2" Margin="24,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource L.Hotkeys}" Foreground="{DynamicResource SubFg}"
                               Margin="0,0,0,7"/>
                    <TextBlock Grid.Row="1" Text="{DynamicResource L.Bookmarks}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <local:HotkeyBox x:Name="HotkeyMenuBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}"/>
                    <TextBlock Grid.Row="2" Text="{DynamicResource L.Notes}" VerticalAlignment="Center" Margin="0,6,10,0"/>
                    <local:HotkeyBox x:Name="HotkeyNotesBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Input}"
                                     Margin="0,6,0,0"/>
                    <CheckBox x:Name="HotkeyOverlayBox" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Toggle}"
                              Margin="0,10,0,0" Content="{DynamicResource L.HotkeyOverlay}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Низ -->
        <!-- Оформление: две независимые настройки цвета -->
        <Border Grid.Row="3" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource MenuBorder}"
                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource L.TabColor}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabSystem" Style="{StaticResource Segment}" GroupName="TabColor"
                                 Content="{DynamicResource L.ColorSystem}" Checked="Appearance_Changed"/>
                    <RadioButton x:Name="TabCustom" Style="{StaticResource Segment}" GroupName="TabColor"
                                 Content="{DynamicResource L.ColorCustom}" Checked="Appearance_Changed"/>
                </StackPanel>
                <local:ColorPicker x:Name="TabPicker" Grid.Row="0" Grid.Column="2" Margin="6,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Text="{DynamicResource L.WindowColor}" VerticalAlignment="Center" Margin="0,10,18,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                    <RadioButton x:Name="MenuSystem" Style="{StaticResource Segment}" GroupName="MenuColor"
                                 Content="{DynamicResource L.ColorSystem}" Checked="Appearance_Changed"/>
                    <RadioButton x:Name="MenuCustom" Style="{StaticResource Segment}" GroupName="MenuColor"
                                 Content="{DynamicResource L.ColorCustom}" Checked="Appearance_Changed"/>
                </StackPanel>
                <local:ColorPicker x:Name="MenuPicker" Grid.Row="1" Grid.Column="2" Margin="6,10,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Text="{DynamicResource L.TabOpacity}" VerticalAlignment="Center" Margin="0,14,18,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <Slider x:Name="OpacitySlider" Style="{StaticResource ThinSlider}" Width="220"
                            Minimum="15" Maximum="100" SmallChange="5" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"
                            ValueChanged="Opacity_Changed"/>
                    <TextBlock x:Name="OpacityLabel" Width="44" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubFg}"/>
                    <TextBlock Text="{DynamicResource L.TabOpacityHint}" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource SubFg}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{DynamicResource L.UiScale}" VerticalAlignment="Center" Margin="0,14,18,0"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <Slider x:Name="ScaleSlider" Style="{StaticResource ThinSlider}" Width="220"
                            Minimum="50" Maximum="200" SmallChange="5" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"
                            ValueChanged="Scale_Changed"/>
                    <TextBlock x:Name="ScaleLabel" Width="44" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubFg}"/>
                    <Button Style="{StaticResource PlainButton}" Padding="10,4" Margin="0,0,10,0"
                            Content="100%" Click="ScaleReset_Click"/>
                    <TextBlock Text="{DynamicResource L.UiScaleHint}" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource SubFg}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button Style="{StaticResource PlainButton}" Content="{DynamicResource L.OpenConfig}" HorizontalAlignment="Left"
                    Click="Config_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PlainButton}" Content="{DynamicResource L.Cancel}" MinWidth="96" Click="Cancel_Click"
                        Margin="0,0,8,0" IsCancel="True"/>
                <Button Style="{StaticResource AccentButton}" Content="{DynamicResource L.Save}" MinWidth="110" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
