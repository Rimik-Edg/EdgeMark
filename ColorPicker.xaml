<UserControl x:Class="EdgeMark.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Кнопка: образец цвета + HEX -->
        <Button x:Name="Swatch" Style="{StaticResource PlainButton}" Padding="7,5" Click="Swatch_Click">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="SwatchFill" Width="24" Height="16" CornerRadius="3"
                        BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1"/>
                <TextBlock x:Name="HexLabel" Margin="8,0,2,0" FontFamily="Consolas" FontSize="12.5"
                           VerticalAlignment="Center"/>
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource SubFg}"/>
            </StackPanel>
        </Button>

        <!-- Палитра -->
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Swatch}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="Pop_Opened">
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,4,10,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel Width="236">
                    <!-- Насыщенность / яркость -->
                    <Grid x:Name="SvArea" Height="150" Cursor="Cross" Background="Transparent"
                          MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Sv_Up">
                        <Border x:Name="SvHue" CornerRadius="5" Background="Red"/>
                        <Border CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False" ClipToBounds="False">
                            <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <!-- Оттенок -->
                    <Grid x:Name="HueArea" Height="14" Margin="0,12,0,0" Cursor="Hand" Background="Transparent"
                          MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Hue_Up">
                        <Border CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                    <GradientStop Color="#00FF00" Offset="0.3333"/>
                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#0000FF" Offset="0.6667"/>
                                    <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False" ClipToBounds="False">
                            <Border x:Name="HueThumb" Width="8" Height="20" Canvas.Top="-3" CornerRadius="4"
                                    Background="White" BorderBrush="#80000000" BorderThickness="1"/>
                        </Canvas>
                    </Grid>

                    <!-- Готовые цвета -->
                    <WrapPanel x:Name="Presets" Margin="0,12,0,0"/>

                    <!-- HEX -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HEX" Foreground="{DynamicResource SubFg}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="HexBox" Grid.Column="1" Style="{StaticResource Input}" FontFamily="Consolas"
                                 KeyDown="HexBox_KeyDown" LostKeyboardFocus="HexBox_LostFocus"/>
                        <Border x:Name="Preview" Grid.Column="2" Width="30" Margin="8,0,0,0" CornerRadius="4"
                                BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
